# GeoWall-E — editor configuration
# Conservative by design: encodes the project's existing conventions
# (spaces, file-scoped namespaces) without turning style into errors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.cs]
# Existing convention across src/: file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_readonly_field = true:suggestion

# Analysis is advisory for now; nothing here fails the build.
dotnet_analyzer_diagnostic.severity = suggestion
