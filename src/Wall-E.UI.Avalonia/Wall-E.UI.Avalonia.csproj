<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <ProjectReference Include="..\Wall-E.Application\Wall-E.Application.csproj" />
    <ProjectReference Include="..\Wall-E.Infrastructure\Wall-E.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundle the example DSL programs next to the executable so the Ejemplos
         picker (ProgramsCatalog) can load them at runtime. -->
    <None Include="..\..\programs\**\*.geo" Link="programs\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
