<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Wall_E.UI.Avalonia.Views"
        xmlns:vm="using:Wall_E.UI.Avalonia.ViewModels"
        x:Class="Wall_E.UI.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GeoWall-E" Width="1200" Height="760">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8">
            <Button x:Name="ProcessButton" Content="Process (F5)" Command="{Binding ProcessCommand}" MinWidth="110" />
            <Button Content="Clear canvas" Command="{Binding ClearCommand}" MinWidth="110" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Opacity="0.8" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,1.6*" Margin="8,0,8,0">
            <TextBox Grid.Column="0"
                     Text="{Binding Code}"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                     FontSize="14"
                     TextWrapping="NoWrap" />
            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                <views:DrawingCanvas x:Name="Canvas" />
            </Border>
        </Grid>

        <Expander Grid.Row="2" Header="Errors" IsExpanded="{Binding Errors.Count}" Margin="8">
            <ListBox ItemsSource="{Binding Errors}" MaxHeight="140"
                     FontFamily="Cascadia Code,Consolas,Menlo,monospace" FontSize="12" />
        </Expander>

    </Grid>
</Window>
